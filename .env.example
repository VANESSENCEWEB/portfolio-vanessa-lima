# =========================================================
# .env.example — MODELO das variáveis de ambiente
# ---------------------------------------------------------
# Hoje o site NÃO precisa de nenhuma variável: roda sem criar nada.
#
# Quando precisar:
#   1. Copie este arquivo para ".env.local"
#   2. Preencha o valor real no .env.local (nunca aqui)
#   3. Na Vercel: Settings → Environment Variables
#
# Regras de segurança:
#   - .env.local NÃO vai para o GitHub (está no .gitignore)
#   - Variável com prefixo NEXT_PUBLIC_ fica VISÍVEL no navegador:
#     nunca use esse prefixo para chaves secretas
# =========================================================

# Endereço público do site (sitemap, robots, Open Graph, JSON-LD).
# Opcional: sem ela, o site usa https://portfolio-vanessa-lima.vercel.app
# Só mude se um dia tiver domínio próprio. Não é segredo.
# NEXT_PUBLIC_SITE_URL=https://portfolio-vanessa-lima.vercel.app

# Token do GitHub (opcional, só leitura de repositórios públicos) — usado no Dia 5.
# SEM o prefixo NEXT_PUBLIC_: fica só no servidor.
# GITHUB_TOKEN=
